{
  "name": "contest-unipol",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "start": "npm run start -w server",
    "test": "vitest run",
    "tokens": "vitest run server/src/budget.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "build": "npm run build -w client",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
